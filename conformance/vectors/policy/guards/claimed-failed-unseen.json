        "operator": "google",
        "agent": "Googlebot",
        "purpose": "search",
        "method": "rdns"
      },
      "context": {
        "path": "/"
      },
      "repeat": 2,
      "expected": {
        "action": "allow",
        "enforced": false,
        "rule": "guards.search_engines",
        "retry_after": null,
        "guarded": true,
        "error": false,
        "response": null
      }
    },
    {
      "result": {
        "verdict": "claimed_failed",
        "operator": "anthropic",
        "agent": "ClaudeBot",
        "purpose": "training",
        "method": "ip"
      },
      "context": {
        "path": "/"
      },
      "expected": {
        "action": "block",
        "enforced": true,
        "rule": "defaults.claimed_failed",
        "retry_after": null,
        "guarded": false,
        "error": false
      }
    }
