{
  "id": "proxy/client-ip-header-missing",
  "description": "When the client-ip header is missing or unreadable, the client is unknown: there is no fallback to X-Forwarded-For, and an IP claim cannot be checked.",
  "spec": [
    "4.2",
    "4.8"
  ],
  "type": "verify",
  "now": "2026-10-26T12:00:00Z",
  "config": {
    "clientIpHeader": "x-real-ip"
  },
  "steps": [
    {
      "request": {
        "method": "GET",
        "scheme": "https",
        "path": "/",
        "remote_address": "10.0.0.5",
        "headers": [
          [
            "host",
            "www.site.example"
          ],
          [
            "user-agent",
            "Mozilla/5.0 (compatible; ExampleBot/2.0; +https://crawler.example/bot)"
          ],
          [
            "x-forwarded-for",
            "192.0.2.77"
          ]
        ]
      },
      "expected": {
        "verdict": "declared_unverifiable",
        "reason": "no_client_address",
        "operator": "ip-crawler",
        "agent": "ExampleBot",
        "purpose": "search",
        "method": "none",
        "error": false,
        "client": {
          "address": null
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "scheme": "https",
        "path": "/",
        "remote_address": "10.0.0.5",
        "headers": [
          [
            "host",
            "www.site.example"
          ],
          [
            "user-agent",
            "Mozilla/5.0 (compatible; ExampleBot/2.0; +https://crawler.example/bot)"
          ],
          [
            "x-real-ip",
            "unknown"
          ]
        ]
      },
      "expected": {
        "verdict": "declared_unverifiable",
        "reason": "no_client_address",
        "operator": "ip-crawler",
        "agent": "ExampleBot",
        "purpose": "search",
        "method": "none",
        "error": false,
        "client": {
          "address": null
        }
      }
    }
  ]
}
