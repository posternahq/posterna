{
  "id": "proxy/client-ip-header-untrusted-peer",
  "description": "With trustedProxies CIDRs, the client-ip header is read only from those proxies. A request straight from the internet is judged by its socket address.",
  "spec": [
    "4.2",
    "9"
  ],
  "type": "verify",
  "now": "2026-10-26T12:00:00Z",
  "config": {
    "clientIpHeader": "x-real-ip",
    "trustedProxies": [
      "10.0.0.0/8"
    ]
  },
  "steps": [
    {
      "request": {
        "method": "GET",
        "scheme": "https",
        "path": "/",
        "remote_address": "203.0.113.50",
        "headers": [
          [
            "host",
            "www.site.example"
          ],
          [
            "user-agent",
            "Mozilla/5.0 (compatible; ExampleBot/2.0; +https://crawler.example/bot)"
          ],
          [
            "x-real-ip",
            "192.0.2.77"
          ]
        ]
      },
      "expected": {
        "verdict": "claimed_failed",
        "reason": "outside_ip_list",
        "operator": "ip-crawler",
        "agent": "ExampleBot",
        "purpose": "search",
        "method": "ip",
        "error": false,
        "client": {
          "address": "203.0.113.50"
        }
      }
    },
    {
      "request": {
        "method": "GET",
        "scheme": "https",
        "path": "/",
        "remote_address": "10.0.0.5",
        "headers": [
          [
            "host",
            "www.site.example"
          ],
          [
            "user-agent",
            "Mozilla/5.0 (compatible; ExampleBot/2.0; +https://crawler.example/bot)"
          ],
          [
            "x-real-ip",
            "192.0.2.77"
          ]
        ]
      },
      "expected": {
        "verdict": "verified_by_ip",
        "reason": null,
        "operator": "ip-crawler",
        "agent": "ExampleBot",
        "purpose": "search",
        "method": "ip",
        "error": false,
        "client": {
          "address": "192.0.2.77"
        }
      }
    }
  ]
}
