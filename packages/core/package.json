{
  "name": "@posterna/core",
  "version": "0.1.0-alpha.0",
  "description": "Verify AI agents and crawlers inside your own process: verifier, policy engine and counters client.",
  "keywords": [
    "ai-agents",
    "crawlers",
    "bots",
    "web-bot-auth",
    "http-message-signatures",
    "rfc9421",
    "verification",
    "policy"
  ],
  "license": "MIT",
  "author": "Joe Waltman",
  "homepage": "https://posterna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posternahq/posterna.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/posternahq/posterna/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./templates/*": "./templates/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@posterna/directory": "workspace:*",
    "http-message-sig": "0.3.0",
    "ipaddr.js": "2.5.0",
    "structured-headers": "2.0.3",
    "web-bot-auth": "0.2.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  }
}
