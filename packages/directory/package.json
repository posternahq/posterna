{
  "name": "@posterna/directory",
  "version": "0.1.0-alpha.0",
  "description": "The open Posterna directory of AI agent and crawler operators, with its build pipeline.",
  "keywords": [
    "ai-agents",
    "crawlers",
    "bots",
    "web-bot-auth",
    "http-message-signatures",
    "directory",
    "robots.txt",
    "open-data"
  ],
  "license": "(MIT AND CC-BY-4.0)",
  "author": "Joe Waltman",
  "homepage": "https://posterna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posternahq/posterna.git",
    "directory": "packages/directory"
  },
  "bugs": {
    "url": "https://github.com/posternahq/posterna/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "data",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "data:fetch": "tsx scripts/fetch.ts",
    "data:build": "tsx scripts/build.ts"
  }
}
