{
  "name": "@posterna/express",
  "version": "0.1.0-alpha.0",
  "description": "Express middleware for Posterna: verify AI agents and crawlers and apply policy.",
  "keywords": [
    "ai-agents",
    "crawlers",
    "bots",
    "web-bot-auth",
    "http-message-signatures",
    "express",
    "middleware"
  ],
  "license": "MIT",
  "author": "Joe Waltman",
  "homepage": "https://posterna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posternahq/posterna.git",
    "directory": "packages/express"
  },
  "bugs": {
    "url": "https://github.com/posternahq/posterna/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "express": "5.3.0"
  },
  "peerDependencies": {
    "express": "^4.21.0 || ^5.0.0"
  },
  "dependencies": {
    "@posterna/core": "workspace:*"
  }
}
