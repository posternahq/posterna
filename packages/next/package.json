{
  "name": "@posterna/next",
  "version": "0.1.1",
  "description": "Next.js integration for Posterna: verify AI agents and crawlers and apply policy.",
  "keywords": [
    "ai-agents",
    "crawlers",
    "bots",
    "web-bot-auth",
    "http-message-signatures",
    "nextjs",
    "middleware",
    "proxy"
  ],
  "license": "MIT",
  "author": "Joe Waltman",
  "homepage": "https://posterna.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/posternahq/posterna.git",
    "directory": "packages/next"
  },
  "bugs": {
    "url": "https://github.com/posternahq/posterna/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./config": {
      "import": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "require": {
        "types": "./dist/config.d.cts",
        "default": "./dist/config.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@posterna/core": "workspace:*"
  },
  "devDependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependencies": {
    "next": "^15.0.0 || ^16.0.0"
  }
}
